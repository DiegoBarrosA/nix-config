# Example secrets.yaml for SOPS
# Encrypt this file with: sops -e -i secrets.yaml

tailscale-key: ENC[AES256_GCM,data:...,type:str]
tailscale-api-key: ENC[AES256_GCM,data:...,type:str]
cloudflare-dns-token: ENC[AES256_GCM,data:...,type:str]  
cloudflare-zone-token: ENC[AES256_GCM,data:...,type:str]

# To create this file:
# 1. Generate age key: age-keygen -o age-key.txt
# 2. Create secrets.yaml with plaintext values
# 3. Encrypt: sops -e -i secrets.yaml

# Tailscale API key is required by the tailscale-dns module to configure
# split DNS. Generate at https://login.tailscale.com/admin/settings/keys
# with the `dns:write` scope, then encrypt: sops -e -i secrets.yaml
