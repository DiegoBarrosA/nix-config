# IMPORTANT: This is an UNENCRYPTED template!
# You MUST encrypt this file before committing using:
#   cd hosts/rubi && sops -e -i secrets.yaml
#
# Or create encrypted secrets directly:
#   cd hosts/rubi && sops secrets.yaml
#
# Required secrets for rubi:

# LUKS disk encryption passphrase (used during installation)
luks-passphrase: REPLACE_WITH_YOUR_PASSPHRASE

# Tailscale authentication key (reusable, from tailscale.com/admin/settings/keys)
tailscale-key: REPLACE_WITH_TAILSCALE_KEY

# User password hash (generate with: mkpasswd -m sha-512)
diego-password: REPLACE_WITH_PASSWORD_HASH
