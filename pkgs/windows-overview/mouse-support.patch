+// index of the window under the pointer, or -1. The pointer is in surface
+// coordinates; the layout is in buffer pixels, hence the scale factor.
+static int32_t window_at (struct windows *w, double x, double y) {
+  double bx = x * w->xs->scale, by = y * w->xs->scale;
+
+  for (uint32_t i = 0; i < w->ea->window_count; i++) {
+    struct expose_algorithm_window *eaw = &w->ea->eaw[i];
+    struct windows_state           *ws  = eaw->data;
+    double                          ww  = ws->sbo->width * eaw->scale;
+    double                          wh  = ws->sbo->height * eaw->scale;
+
+    if (bx >= eaw->x && bx < eaw->x + ww && by >= eaw->y && by < eaw->y + wh)
+      return i;
+  }
+
+  return -1;
+}
+
+static void focus_only (struct windows *w, int32_t index) {
+  for (uint32_t i = 0; i < w->ea->window_count; i++)
+    w->ea->eaw[i].focused = (int32_t) i == index;
+
+  w->render = true;
+}
+
+static void motion (void *data, double x, double y) {
+  struct windows *w     = data;
+  int32_t         index = window_at (w, x, y);
+
+  if (index >= 0 && !w->ea->eaw[index].focused)
+    focus_only (w, index);
+}
+
+// click a window to select it, click empty space to dismiss
+static void click (void *data, double x, double y) {
+  struct windows *w     = data;
+  int32_t         index = window_at (w, x, y);
+
+  if (index < 0) {
+    escape (data);
+    return;
+  }
+
+  focus_only (w, index);
+  enter (data);
+}
+
