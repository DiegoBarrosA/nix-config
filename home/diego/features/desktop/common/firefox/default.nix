{
  pkgs,
  lib,
  inputs,
  config,
  ...
}:

let
  extension = shortId: guid: {
    name = guid;
    value = {
      install_url = "https://addons.mozilla.org/en-US/firefox/downloads/latest/${shortId}/latest.xpi";
      installation_mode = "normal_installed";
    };
  };

  c = config.colorscheme.colors;
  font = config.stylix.fonts.sansSerif;

  userChromeColours = ''
    :root {
      --tab-font: "${font.name}";
      --urlbar-font: "${font.name}";
      --uc-font-size: ${toString config.stylix.fonts.sizes.desktop}pt;
      --navbar-height-setting: ${toString config.bar.height}px;
      --tab-min-height: ${toString config.bar.height}px !important;
      --tab-active-bg-color: #${c.base02};
      --tab-inactive-bg-color: #${c.base00};
      --tab-active-fg-fallback-color: #${c.base05};
      --tab-inactive-fg-fallback-color: #${c.base04};
      --urlbar-focused-bg-color: #${c.base01};
      --urlbar-not-focused-bg-color: #${c.base00};
      --toolbar-bgcolor: #${c.base00} !important;
    }
  '';

  profileSettings = {
    "browser.startup.homepage" = "https://home.minerales.network/";
    "browser.startup.page" = 1;
    "browser.newtabpage.url" = "https://home.minerales.network/";

    "media.peerconnection.video.min_bitrate" = 512;
    "media.peerconnection.video.start_bitrate" = 1500;
    "media.peerconnection.video.max_bitrate" = 8000;

    "media.ffmpeg.vaapi.enabled" = true;

    "toolkit.legacyUserProfileCustomizations.stylesheets" = true;
    "svg.context-properties.content.enabled" = true;

    "browser.compactmode.show" = true;
    "browser.uidensity" = 1;
  };

  mkPref = name: value: "user_pref(\"${name}\", ${builtins.toJSON value});";

  userJs = ''
    // Generated by Home Manager.

    ${lib.concatStringsSep "\n" (lib.mapAttrsToList mkPref profileSettings)}
  '';

  profilesIni = ''
    [General]
    StartWithLastProfile=0
    Version=2

    [Profile0]
    Default=1
    IsRelative=1
    Name=default
    Path=default
  '';

  profilesIniFile = pkgs.writeText "firefox-profiles.ini" profilesIni;
in
{

  home.sessionVariables.MOZ_ENABLE_WAYLAND = "1";

  programs.firefox = {
    enable = true;
    package = pkgs.firefox-esr;

    policies = {
      DisableTelemetry = true;
      DisableFirefoxAccounts = true;
      DisablePocket = true;

      ExtensionSettings = builtins.listToAttrs [
        (extension "ublock-origin" "uBlock0@raymondhill.net")
      ];

      SearchEngines = {
        Default = "ddg";
        Add = [
          {
            Name = "nixpkgs packages";
            URLTemplate = "https://search.nixos.org/packages?query={searchTerms}";
            IconURL = "https://wiki.nixos.org/favicon.ico";
            Alias = "@np";
          }
          {
            Name = "NixOS options";
            URLTemplate = "https://search.nixos.org/options?query={searchTerms}";
            IconURL = "https://wiki.nixos.org/favicon.ico";
            Alias = "@no";
          }
          {
            Name = "NixOS Wiki";
            URLTemplate = "https://wiki.nixos.org/w/index.php?search={searchTerms}";
            IconURL = "https://wiki.nixos.org/favicon.ico";
            Alias = "@nw";
          }
          {
            Name = "noogle";
            URLTemplate = "https://noogle.dev/q?term={searchTerms}";
            IconURL = "https://noogle.dev/favicon.ico";
            Alias = "@ng";
          }
        ];
      };
    };
  };

  programs.firefox.profiles.default.extensions.force = true;

  stylix.targets.firefox = {
    enable = true;
    profileNames = [ "default" ];
    colorTheme.enable = true;
  };

  home.activation.firefoxProfilesIni = ''
    ${pkgs.coreutils}/bin/install -Dm 600 ${profilesIniFile} "$HOME/.mozilla/firefox/profiles.ini"
  '';

  home.file =
    let
      profilePath = ".mozilla/firefox/default";
      profileChrome = "${profilePath}/chrome";
    in
    {
      "${profilePath}/.keep".text = "";
      "${profilePath}/user.js".text = userJs;
      "${profileChrome}/userChrome.css".source = "${inputs.firefox-userchrome}/userChrome.css";

      "${profileChrome}/colours.css".text = userChromeColours;
    };
}
